<%- include('partials/header', { titulo: titulo }) %>

<style>
    .results-header {
        padding: 60px 0 30px 0;
        text-align: center;
        background-color: #f4f6f8;
        border-bottom: 1px solid #eee;
    }
    .results-header h1 {
        color: var(--color-primario);
        margin-bottom: 10px;
    }
    .results-header p {
        color: #666;
        font-size: 18px;
    }
    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: #777;
    }
    .empty-state i {
        font-size: 50px;
        margin-bottom: 20px;
        color: #ddd;
    }
    .btn-volver {
        display: inline-block;
        margin-top: 20px;
        padding: 10px 25px;
        background-color: var(--color-primario);
        color: white;
        border-radius: 5px;
        text-decoration: none;
        transition: 0.3s;
    }
    .btn-volver:hover {
        background-color: #0d5a8a;
    }
</style>

<main>
    <div class="results-header">
        <div class="container">
            <h1>Resultados de Búsqueda</h1>
            <p>Mostrando resultados para: "<strong><%= busqueda %></strong>"</p>
        </div>
    </div>

    <section class="productos" style="padding-top: 40px; min-height: 50vh;">
        <div class="container">
            
            <% if (productos.length > 0) { %>
                <div class="product-grid">
                    <% productos.forEach(p => { %>
                        <div class="product-card">
                            <a href="/producto?id=<%= p.id || p._id %>" style="text-decoration: none; color: inherit;">
                                <img src="<%= p.imagen ? p.imagen.split(',')[0] : '/img/favicon.png' %>" alt="<%= p.nombre %>">
                                <div class="product-card-content">
                                    <p style="font-size: 13px; color: var(--color-secundario); margin-bottom: 5px;">
                                        <%= p.marca %>
                                    </p>
                                    <h3><%= p.nombre %></h3>
                                    <p><%= p.modelo || '' %></p>
                                    <span class="cta-button-secundario" style="font-size: 14px; padding: 8px 15px;">Ver Detalle</span>
                                </div>
                            </a>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-search"></i>
                    <h2>No encontramos coincidencias</h2>
                    <p>No hay productos que coincidan con "<strong><%= busqueda %></strong>".</p>
                    <p>Intenta verificar la ortografía o usar términos más generales.</p>
                    <a href="/" class="btn-volver">Volver al Inicio</a>
                </div>
            <% } %>

        </div>
    </section>
</main>

<%- include('partials/footer') %>