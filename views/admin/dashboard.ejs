        function editarCurso(id) {
            resetForm('form-curso');
            const c = DATA_CURSOS.find(item => item._id === id);
            if(!c) return alert("Error al cargar curso");

            document.getElementById('cur_edit_id').value = c._id;
            document.getElementById('cur_titulo').value = c.titulo;
            document.getElementById('cur_descripcion').value = c.descripcion;
            document.getElementById('cur_disertante').value = c.disertante || '';
            document.getElementById('cur_link').value = c.link_reunion || '';
            document.getElementById('cur_cupo').value = c.cupo_maximo || '';
            document.getElementById('cur_activo').checked = c.activo !== false;

            // Date → formato datetime-local "YYYY-MM-DDTHH:mm" (con compensación de timezone)
            if (c.fecha) {
                const d = new Date(c.fecha);
                const tzOffset = d.getTimezoneOffset() * 60000;
                const localISO = new Date(d.getTime() - tzOffset).toISOString().slice(0, 16);
                document.getElementById('cur_fecha').value = localISO;
            }

            colasDeArchivos['curso'] = [];
            cargarImagenesExistentes('preview-curso', c.imagen_url);
            window.scrollTo(0, 0);
            showSection('cursos');
        }

        // Cache de inscriptos del curso actualmente abierto (usado por mailto y CSV)
        let inscriptosActuales = [];

        async function verInscriptos(idCurso, tituloCurso) {
            // Mostramos la sub-vista pero dejamos "Cursos" como tab activa del sidebar
            showSection('cursos-inscriptos', 'cursos');
            document.getElementById('ins-titulo-curso').textContent = 'Inscriptos: ' + tituloCurso;
            const tbody = document.getElementById('tabla-inscriptos-body');
            tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding: 20px; color: #666;">Cargando inscriptos...</td></tr>';

            // Botón CSV
            document.getElementById('btn-csv').onclick = () => {
                window.location.href = `/admin/cursos/${idCurso}/inscriptos/csv`;
            };

            try {
                const res = await fetch(`/admin/cursos/${idCurso}/inscriptos`);
                const data = await res.json();
                if (!data.success) throw new Error('Error al cargar inscriptos');

                inscriptosActuales = data.inscriptos;

                // Botón "Email a todos": abre el modal de redacción
                document.getElementById('btn-mailto').onclick = () => {
                    if (inscriptosActuales.length === 0) {
                        alert('No hay inscriptos para enviarles email.');
                        return;
                    }
                    abrirModalEmail(idCurso, tituloCurso, inscriptosActuales.length);
                };

                if (data.inscriptos.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding: 20px; color: #666;">Todavía no hay inscriptos para este curso.</td></tr>';
                    return;
                }

                tbody.innerHTML = '';
                data.inscriptos.forEach(i => {
                    const fila = document.createElement('tr');
                    const fecha = new Date(i.createdAt).toLocaleString('es-AR', { dateStyle: 'short', timeStyle: 'short' });
                    fila.innerHTML = `
                        <td>${i.nombre_completo}</td>
                        <td>${i.documento}</td>
                        <td><a href="mailto:${i.email}" style="color: var(--color-primario);">${i.email}</a></td>
                        <td>${i.telefono}</td>
                        <td>${i.profesion}</td>
                        <td>${i.institucion}</td>
                        <td>${fecha}</td>
                    `;
                    tbody.appendChild(fila);
                });
            } catch (e) {
                console.error(e);
                tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding: 20px; color: red;">Error al cargar inscriptos.</td></tr>';
            }
        }
        // --- 5. LOGICA DE BÚSQUEDA Y FILTRADO INTELIGENTE ---
    
        const searchInput = document.getElementById('admin-search-input');
        const categoryFilter = document.getElementById('admin-category-filter');
        const tableBody = document.getElementById('tabla-productos-body');

        // 1. Inicialización: Llenar el select de filtros dinámicamente
        function inicializarFiltros() {
            const especialidadesUnicas = new Set();
            
            DATA_PRODUCTOS.forEach(p => {
                // Manejamos el caso de que sea array o string
                let cats = [];
                if (Array.isArray(p.categoria)) cats = p.categoria;
                else if (typeof p.categoria === 'string') cats = p.categoria.split(',').map(s => s.trim());
                
                cats.forEach(c => {
                    if(c) especialidadesUnicas.add(c);
                });
            });

            // Ordenamos alfabéticamente y creamos las opciones
            Array.from(especialidadesUnicas).sort().forEach(cat => {
                const option = document.createElement('option');
                option.value = cat;
                option.textContent = cat;
                categoryFilter.appendChild(option);
            });
            
            // Renderizar la tabla inicial completa
            renderTabla(DATA_PRODUCTOS);
        }

        // 2. Función para dibujar la tabla
        function renderTabla(lista) {
            tableBody.innerHTML = '';
            
            if (lista.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding: 20px; color: #666;">No se encontraron resultados para tu búsqueda.</td></tr>`;
                return;
            }

            lista.forEach(p => {
                const imagen = p.imagen ? p.imagen.split(',')[0] : '/img/favicon.png';
                // Creamos la fila HTML
                const fila = `
                    <tr>
                        <td><img src="${imagen}" class="thumb"></td>
                        <td><strong>${p.nombre}</strong></td>
                        <td>${p.marca}</td>
                        <td>${p.modelo || '-'}</td>
                        <td>
                            <button class="btn-action btn-edit" onclick="editarProducto('${p._id}')">
                                <i class="fas fa-edit"></i> Editar
                            </button>
                            <button class="btn-action btn-delete" onclick="borrarItem('/admin/productos/delete/${p._id}')">
                                <i class="fas fa-trash"></i> Borrar
                            </button>
                        </td>
                    </tr>
                `;
                tableBody.innerHTML += fila;
            });
        }

        // 3. Función Principal de Filtrado
        function filtrarProductos() {
            const textoBusqueda = searchInput.value.toLowerCase().trim();
            let categoriaSeleccionada = categoryFilter.value;

            // LÓGICA INTELIGENTE: Si escriben una categoría exacta, activar el filtro solo
            const opciones = Array.from(categoryFilter.options).map(o => o.value);
            // Buscamos si lo que escribió el usuario coincide con alguna especialidad (ej: "Anestesia")
            const coincidenciaCategoria = opciones.find(opt => opt.toLowerCase() === textoBusqueda);
            
            if (coincidenciaCategoria) {
                categoryFilter.value = coincidenciaCategoria;
                categoriaSeleccionada = coincidenciaCategoria;
                // Opcional: Si quieres que al detectarla se borre el texto para dejar solo el filtro:
                // searchInput.value = ""; 
            }

            // Filtramos los datos
            const resultados = DATA_PRODUCTOS.filter(p => {
                const nombre = (p.nombre || '').toLowerCase();
                const marca = (p.marca || '').toLowerCase();
                const modelo = (p.modelo || '').toLowerCase();
                
                // Normalizamos categorías del producto
                let cats = [];
                if (Array.isArray(p.categoria)) cats = p.categoria;
                else if (typeof p.categoria === 'string') cats = p.categoria.split(',').map(s => s.trim());
                const catsString = cats.join(' ').toLowerCase(); // Para buscar texto dentro de las categorías

                // Condición 1: Coincidencia de Texto (busca en nombre, marca, modelo O nombre de la categoría)
                const matchTexto = nombre.includes(textoBusqueda) || 
                                marca.includes(textoBusqueda) || 
                                modelo.includes(textoBusqueda) ||
                                catsString.includes(textoBusqueda);

                // Condición 2: Coincidencia de Filtro Select
                const matchFiltro = categoriaSeleccionada === "" || cats.includes(categoriaSeleccionada);

                return matchTexto && matchFiltro;
            });

            renderTabla(resultados);
        }

        // Ejecutar al inicio
        inicializarFiltros();

        document.addEventListener('paste', (e) => {
            // 1. Obtener los items del portapapeles
            const items = (e.clipboardData || e.originalEvent.clipboardData).items;
            let archivosParaSubir = [];

            // 2. Buscar solo imágenes
            for (let i = 0; i < items.length; i++) {
                const item = items[i];
                if (item.kind === 'file' && item.type.startsWith('image/')) {
                    archivosParaSubir.push(item.getAsFile());
                }
            }

            // Si no hay imágenes (ej: pegaste solo texto), salimos para que el texto se pegue normal
            if (archivosParaSubir.length === 0) return;

            // 3. Detectar qué sección está activa (Productos, Novedades o Eventos)
            const seccionActiva = document.querySelector('.section.active');
            if (!seccionActiva) return;

            // Mapeamos el ID de la sección (plural) al tipo que usa el sistema (singular)
            let tipo = '';
            if (seccionActiva.id === 'productos') tipo = 'producto';
            else if (seccionActiva.id === 'novedades') tipo = 'novedad';
            else if (seccionActiva.id === 'eventos') tipo = 'evento';
            else if (seccionActiva.id === 'cursos') tipo = 'curso';

            // 4. Procesar la imagen
            if (tipo) {
                e.preventDefault(); // Evita que el navegador intente "pegar" la imagen como archivo binario
                
                const container = document.getElementById(`preview-${tipo}`);
                const dropZone = document.getElementById(`drop-${tipo}`);

                // Usamos tu función existente 'agregarArchivos' que ya maneja la cola, vista previa y borrado
                agregarArchivos(archivosParaSubir, tipo, container);

                // Feedback Visual: Iluminar el borde del cuadro por un momento
                dropZone.classList.add('dragover');
                setTimeout(() => dropZone.classList.remove('dragover'), 500);
                
                // Opcional: Scroll suave hacia la zona de fotos para que el usuario vea que se agregó
                dropZone.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
    </script>
