    <script>
        const modalPw = document.getElementById('modalPassword');
        const formPw = document.getElementById('formCambiarPassword');
        const msgPw = document.getElementById('passwordMsg');

        function abrirModalPassword() {
            modalPw.style.display = 'block';
            formPw.reset();
            msgPw.style.display = 'none';
        }

        function cerrarModalPassword() {
            modalPw.style.display = 'none';
        }

        // Cerrar modal si el usuario hace clic fuera de la caja blanca
        window.addEventListener('click', (e) => {
            if (e.target === modalPw) {
                cerrarModalPassword();
            }
        });

        formPw.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const passwordActual = document.getElementById('passwordActual').value;
            const nuevaPassword = document.getElementById('nuevaPassword').value;
            const confirmarPassword = document.getElementById('confirmarPassword').value;

            // Validación rápida en el navegador antes de enviar al servidor
            if (nuevaPassword !== confirmarPassword) {
                msgPw.textContent = 'Las contraseñas nuevas no coinciden.';
                msgPw.style.color = 'red';
                msgPw.style.display = 'block';
                return;
            }

            try {
                const response = await fetch('/admin/cambiar-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ passwordActual, nuevaPassword, confirmarPassword })
                });
                const data = await response.json();

                if (data.success) {
                    alert('¡Contraseña cambiada con éxito!');
                    cerrarModalPassword();
                } else {
                    // Mostrar el error que viene del servidor (ej: contraseña actual incorrecta)
                    msgPw.textContent = data.message;
                    msgPw.style.color = 'red';
                    msgPw.style.display = 'block';
                }
            } catch (error) {
                msgPw.textContent = 'Error de conexión con el servidor.';
                msgPw.style.color = 'red';
                msgPw.style.display = 'block';
            }
        });
    </script>

    <script>
        // --- MODAL ENVIAR EMAIL ---
        const modalEmail = document.getElementById('modalEmail');
        const formEmail = document.getElementById('formEnviarEmail');

        function abrirModalEmail(idCurso, tituloCurso, cantidadInscriptos) {
            document.getElementById('email-curso-id').value = idCurso;
            document.getElementById('email-info-destinatarios').textContent =
                `Se enviará a ${cantidadInscriptos} inscripto(s) del curso "${tituloCurso}" (en copia oculta).`;
            document.getElementById('email-asunto').value = 'Información del curso: ' + tituloCurso;
            document.getElementById('email-cuerpo').value = '';
            document.getElementById('email-adjuntos').value = '';
            document.getElementById('email-status').textContent = '';
            const btn = document.getElementById('btn-enviar-email');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-paper-plane"></i> Enviar';
            modalEmail.style.display = 'block';
        }

        function cerrarModalEmail() {
            modalEmail.style.display = 'none';
        }

        // Cerrar al clic en el fondo
        window.addEventListener('click', (e) => {
            if (e.target === modalEmail) cerrarModalEmail();
        });

        formEmail.addEventListener('submit', async (e) => {
            e.preventDefault();
            const idCurso = document.getElementById('email-curso-id').value;
            const btn = document.getElementById('btn-enviar-email');
            const status = document.getElementById('email-status');

            const formData = new FormData();
            formData.append('asunto', document.getElementById('email-asunto').value);
            formData.append('cuerpo', document.getElementById('email-cuerpo').value);

            const archivos = document.getElementById('email-adjuntos').files;
            for (let i = 0; i < archivos.length; i++) {
                formData.append('adjuntos', archivos[i]);
            }

            btn.disabled = true;
            btn.innerHTML = 'Enviando...';
            status.style.color = '#666';
            status.textContent = 'Enviando emails, aguardá un momento...';

            try {
                const res = await fetch(`/admin/cursos/${idCurso}/enviar-email`, {
                    method: 'POST',
                    body: formData
                });

                // Si el servidor no devuelve JSON, suele ser un adjunto rechazado por tamaño
                const contentType = res.headers.get('content-type');
                if (!contentType || !contentType.includes('application/json')) {
                    throw new Error('El servidor rechazó la solicitud (¿algún archivo supera los 15 MB?).');
                }

                const data = await res.json();
                if (data.success) {
                    status.style.color = 'green';
                    status.textContent = '✓ ' + data.message;
                    setTimeout(cerrarModalEmail, 2500);
                } else {
                    status.style.color = '#e74c3c';
                    status.textContent = '✗ ' + data.message;
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-paper-plane"></i> Reintentar';
                }
            } catch (err) {
                console.error(err);
                status.style.color = '#e74c3c';
                status.textContent = '✗ ' + err.message;
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane"></i> Reintentar';
            }
        });
    </script>

</body>
</html>
